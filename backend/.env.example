# ==========================================
# SPay Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Database Configuration (Option 1: Standard Connection Parameters)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=spay_db
DB_SSL=false

# Database Configuration (Option 2: Connection URL / URI - Useful for Cloud MySQL)
# DATABASE_URL=mysql://username:password@host:3306/spay_db
